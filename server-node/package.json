{
  "name": "annotepage-server",
  "version": "0.1.0",
  "description": "The annotepage server as a Node library you embed, or a standalone server you run (npx annotepage-server): the seven addresses, the store and the bounds, over the web-standard Request/Response. No PHP, no framework.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "annotepage-server": "bin/annotepage-server.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./stores/sqlite": "./src/store-sqlite.js",
    "./adapters": "./src/adapters.js",
    "./cli": "./src/cli.js"
  },
  "files": [
    "src/",
    "bin/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuxo83/annotepage.git",
    "directory": "server-node"
  },
  "homepage": "https://annotepage.com",
  "scripts": {
    "test": "node --test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
