# interne/ — rien ici n'est destine a etre appele par le web.
#
# CEINTURE. La bretelle, elle, ne depend d'aucun module : chaque fichier de ce
# dossier commence par une constante-garde posee uniquement par api.php, et
# repond 404 si on l'appelle directement. C'est cette garde qui protege
# reellement ; ce fichier ne fait que doubler.
#
# Pourquoi ne pas s'y fier : la prise en compte des directives d'autorisation
# dans un .htaccess depend du AllowOverride du serveur, qui n'est pas toujours
# connu. Si elles ne sont pas autorisees ici, le serveur repondra une erreur
# 500 sur ce dossier — ce qui refuse l'acces aussi, mais pour une mauvaise
# raison. On ne fait jamais reposer une protection sur ce seul fichier.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
