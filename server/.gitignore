# The local configuration carries the database credentials and the list of
# projects. It is DROPPED IN on each server, never versioned -- the template to
# copy from is.
webroot/internal/config-local.php

# The updater's staging, backups and state. It appears only on a server that
# has been given permission to rewrite itself, and it is per-server: nothing in
# there describes the project.
webroot/.update/

# The SQLite database and its guards, when the installer had nowhere better
# than the served directory to put them. Per-server, and it holds the notes.
webroot/ap-data-*/
