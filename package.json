{
  "name": "annotepage",
  "private": true,
  "description": "Monorepo root. The published packages are client/ and mcp/.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuxo83/annotepage.git"
  },
  "scripts": {
    "build": "node client/tools/build.mjs",
    "check": "npm run check:bundle && npm run check:sri && npm run check:injection && npm run check:css && npm run check:html && npm run check:shell && npm run check:versions && npm run check:manifest && npm run check:landing && npm run check:client && npm run check:mcp",
    "check:sri": "node tools/check-sri.mjs",
    "check:injection": "node tools/check-no-html-injection.mjs",
    "check:versions": "node tools/check-versions.mjs",
    "check:manifest": "node tools/build-server-manifest.mjs --check",
    "check:client": "node client/tools/check.mjs",
    "check:mcp": "node mcp/tools/check.mjs",
    "check:landing": "node tools/check-landing-derivation.mjs",
    "check:css": "node tools/check-css-balance.mjs",
    "check:html": "node tools/check-html-nesting.mjs",
    "check:shell": "node tools/check-shell.mjs",
    "check:bundle": "node tools/check-bundle-parses.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
