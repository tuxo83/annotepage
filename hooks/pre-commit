#!/bin/bash
# ---------------------------------------------------------------------------
# BEFORE A COMMIT: the leak guard, and nothing else.
#
# The checks belong to pre-push, not here. `npm run check` takes seconds, and a
# commit is the unit of work in this repository -- gating every one of them
# would make people commit less, which is the opposite of what is wanted. What
# CANNOT wait is the leak guard: once a name is in a commit it is in the
# history, and a later commit does not take it out.
# ---------------------------------------------------------------------------
set -u
here="$(dirname "$0")"

# AND NO ASSISTANT'S NAME, which is the other thing a commit carries for ever.
# Here rather than in pre-push for the same reason as the guard above: once it
# is in a commit it is in the history, and a later commit does not take it out.
# This half reads the git identity and the lines the commit ADDS -- never the
# lines it removes, or the guard would forbid its own cleanup.
node "${here}/../tools/check-ai-names.mjs" staged || exit 1

exec "${here}/guard.sh"
