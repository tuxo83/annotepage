#!/bin/bash
# ---------------------------------------------------------------------------
# BEFORE A PUSH: everything, because a push is what reaches production.
#
# WHY THIS EXISTS. A release went out with `npm run check` failing -- it had
# been run, the output had not been read -- and the next one went out with a
# bundle the browser refuses to parse, which left the tool non-existent on
# every page carrying it. Both were found by a person, afterwards, on the live
# site. A gate that depends on somebody reading a screen is not a gate.
#
# Pushing is the last moment anything can still be stopped: GitHub Pages
# deploys from main, and the publish workflow publishes from main.
#
# --no-verify still bypasses it, as it bypasses every hook. That is git's
# design and not a hole to plug here: what this removes is the failure that
# actually happened, which is a green-looking screen nobody read.
# ---------------------------------------------------------------------------
set -u

# LES DEUX MOITIES DU MEME GARDE-FOU.
#
# Celle-ci connait des NOMS et vit hors du depot, donc elle ne tourne que sur
# cette machine. L'autre -- check-shapes.mjs, dans `npm run check` ci-dessous --
# connait des FORMES et tourne partout, y compris en integration continue :
# un chemin de home, une adresse e-mail, une adresse machine. Aucune des deux
# ne remplace l'autre.
echo "--- garde-fou local : noms (hors depot, expres)"
"$(dirname "$0")/garde.sh" || exit 1

# LES MESSAGES DES COMMITS QUI PARTENT, et pas seulement les fichiers. Un
# commit fabrique ailleurs -- une fusion, un rebase, une machine sans ces
# crochets -- arrive ici sans etre jamais passe par commit-msg. C'est le
# dernier endroit ou on peut le refuser avant qu'il soit public.
#
# CE QUI PART EST LU SUR L'ENTREE STANDARD, ce que git nous donne expres :
# une ligne par ref poussee, "<ref locale> <sha local> <ref distante> <sha
# distant>". La premiere version codait en dur "origin/main..HEAD" -- alors
# une poussee de `next` regardait une portee vide et repartait au vert, et
# c'est exactement la branche par laquelle des noms sont restes en ligne.
# Un audit l'a trouve ; ce n'est pas une hypothese.
echo "--- aucun assistant ne signe les commits qui partent"
partent=0
while read -r ref_locale sha_local ref_distante sha_distant; do
    [ -z "${sha_local:-}" ] && continue
    # une suppression de branche : rien ne part
    case "$sha_local" in *[!0]*) : ;; *) continue ;; esac
    if [ -z "${sha_distant:-}" ] || ! echo "$sha_distant" | grep -q '[1-9a-f]'; then
        portee="$sha_local"                 # ref neuve : tout ce qu'elle porte
    else
        portee="$sha_distant..$sha_local"   # ce que cette poussee ajoute
    fi
    node "$(dirname "$0")/../tools/check-ai-names.mjs" range "$portee" || exit 1
    partent=1
done
# Rien sur l'entree standard -- appel a la main, ou git qui n'a rien a dire :
# on ne peut pas conclure, donc on regarde tout ce que HEAD porte.
if [ "$partent" = 0 ]; then
    node "$(dirname "$0")/../tools/check-ai-names.mjs" range HEAD || exit 1
fi

echo "--- npm run check : bundle, sri, injection, css, html, shell, versions,"
echo "    manifest, landing, client, mcp"
if ! npm run check --silent; then
    echo
    echo "REFUSE : la suite echoue. Rien ne part."
    echo "Corriger la cause, jamais le controle."
    exit 1
fi

echo "--- ce qui est deja en ligne sous ce numero"
if ! node tools/check-published.mjs; then
    echo
    echo "REFUSE : la version publiee et ce qui est ici ne sont pas le meme fichier."
    exit 1
fi

echo "--- tout est vert"
