#!/bin/bash
# ---------------------------------------------------------------------------
# BEFORE A PUSH: everything, because a push is what reaches production.
#
# WHY THIS EXISTS. A release went out with `npm run check` failing -- it had
# been run, the output had not been read -- and the next one went out with a
# bundle the browser refuses to parse, which left the tool non-existent on
# every page carrying it. Both were found by a person, afterwards, on the live
# site. A gate that depends on somebody reading a screen is not a gate.
#
# Pushing is the last moment anything can still be stopped: GitHub Pages
# deploys from main, and the publish workflow publishes from main.
#
# --no-verify still bypasses it, as it bypasses every hook. That is git's
# design and not a hole to plug here: what this removes is the failure that
# actually happened, which is a green-looking screen nobody read.
# ---------------------------------------------------------------------------
set -u

# TWO HALVES OF ONE GUARD.
#
# This half knows NAMES and lives outside the repository, so it only ever runs
# on this machine. The other -- check-shapes.mjs, inside `npm run check` below
# -- knows SHAPES and runs everywhere, continuous integration included: a home
# directory, an email address, a machine address. Neither replaces the other.
echo "--- local guard: names (outside the repository, on purpose)"
"$(dirname "$0")/guard.sh" || exit 1

# THE MESSAGES OF THE COMMITS BEING PUSHED, not only the files. A commit made
# elsewhere -- a merge, a rebase, a machine without these hooks -- arrives here
# having never passed commit-msg. This is the last place it can be refused
# before it is public.
#
# WHAT IS BEING PUSHED IS READ ON STANDARD INPUT, which is what git hands us
# for exactly this: one line per ref, "<local ref> <local sha> <remote ref>
# <remote sha>". The first version hardcoded one branch against HEAD, so
# pushing the other looked at an empty range and went green -- and that is
# precisely the branch by which names stayed online. An audit found it; it is
# not a hypothesis.
echo "--- no assistant signs the commits being pushed"
pushing=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    # A branch deletion: nothing is going out.
    case "$local_sha" in *[!0]*) : ;; *) continue ;; esac
    if [ -z "${remote_sha:-}" ] || ! echo "$remote_sha" | grep -q '[1-9a-f]'; then
        range="$local_sha"                  # a new ref: everything it carries
    else
        range="$remote_sha..$local_sha"     # what this push adds
    fi
    node "$(dirname "$0")/../tools/check-ai-names.mjs" range "$range" || exit 1
    pushing=1
done
# Nothing on standard input -- called by hand, or git with nothing to say: we
# cannot conclude, so we look at everything HEAD carries.
if [ "$pushing" = 0 ]; then
    node "$(dirname "$0")/../tools/check-ai-names.mjs" range HEAD || exit 1
fi

echo "--- npm run check : bundle, sri, injection, css, html, shell, versions,"
echo "    manifest, landing, client, mcp"
if ! npm run check --silent; then
    echo
    echo "REFUSED: the suite fails. Nothing goes out."
    echo "Fix the cause, never the check."
    exit 1
fi

echo "--- what is already online under this version number"
if ! node tools/check-published.mjs; then
    echo
    echo "REFUSED: the published version and what is here are not the same file."
    exit 1
fi

echo "--- all green"
